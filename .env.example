# =====================================================================
# IIBC Backlog 期日アラート — 環境変数テンプレート
# このファイルをコピーして .env を作成し、値を埋めてください。
# 本番（Claude Code web 定期トリガー）では .env ではなく
# 「環境のシークレット/環境変数」として登録してください（チャットに貼らない）。
# =====================================================================

# --- Backlog（スクレイピング用ログイン情報）------------------------------
# 例: https://your-space.backlog.com  または  https://your-space.backlog.jp
BACKLOG_SPACE_URL=
BACKLOG_LOGIN_ID=
BACKLOG_PASSWORD=
# 2要素認証(TOTP)シークレットキー(Base32)。【必須】このスペースは2FAが有効です。
# 認証アプリ登録時に表示される「キー」を設定（QRではなく文字列のキー）。未設定だと起動時にエラー。
BACKLOG_TOTP_SECRET=

# --- 対象プロジェクト（Backlog のプロジェクトキー）----------------------
# カンマ区切りではなく config/config.json で詳細設定。ここは上書き用（任意）。
# BACKLOG_PROJECT_KEYS=HUBS_CMS_TASK,100_REQUESTS

# --- Slack（送信は Claude の Slack MCP が行うため token は不要）----------
# 通知先チャンネルID（#sol-prj-iibc-op）
SLACK_CHANNEL_ID=C09CYQLNQNR

# --- 動作オプション -----------------------------------------------------
# 祝日（平日に当たる国民の祝日）の場合に通知をスキップするか
SKIP_ON_HOLIDAY=false
# Playwright をヘッドレスで動かすか（本番は true）
HEADLESS=true
# スクレイピングのタイムアウト(ms)
NAV_TIMEOUT_MS=45000
